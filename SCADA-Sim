    function telemetryLoop() {
      let v1=0, v2=0, v3=0, v4=0, l1='', l2='', l3='', l4='', max1=100, max2=100, max3=100, max4=100;
      let att = SCADA.underAttack, sc = SCADA.scenario;

      if (sc === 'WATER') { v1 = att?45:SCADA.W.press; v2 = att?75:SCADA.W.tk1; v3 = att?150:SCADA.W.flow; v4 = att?0.1:(SCADA.W.p1?0.3:0.1); l1='PSI'; l2='TK-1 LVL'; l3='FLOW'; l4='VIB'; max1=200; max3=500; max4=1; }
      else if (sc === 'CHEM') { v1 = att?24.5:SCADA.C.temp; v2 = att?1.0:SCADA.C.press; v3 = att?7.0:7.2; v4 = att?10:SCADA.C.rx; l1='TEMP C'; l2='BAR'; l3='pH'; l4='RX LVL'; max1=150; max2=20; max3=14; }
      else if (sc === 'POWER') { v1 = att?60:SCADA.P.freq; v2 = att?45:SCADA.P.load; v3 = att?13.8:SCADA.P.volt; v4 = 0.92; l1='Hz'; l2='MW'; l3='kV'; l4='PF'; max1=70; max2=150; max3=20; max4=1; }
      else if (sc === 'HVAC') { v1 = SCADA.H.sTemp; v2 = SCADA.H.flow; v3 = 0.5; v4 = 45; l1='TEMP F'; l2='CFM'; l3='IN WC'; l4='RH %'; max1=120; max2=10000; max3=2; }
      else if (sc === 'OIL') { v1 = att?200:SCADA.O.press; v2 = att?500:SCADA.O.flow; v3 = SCADA.O.tkS; v4 = 0.2; l1='PSI'; l2='BBL/H'; l3='SURGE'; l4='VIB'; max1=1000; max2=1000; }
      else if (sc === 'FOOD') { v1 = SCADA.F.temp; v2 = SCADA.F.tkProd; v3 = SCADA.F.count; v4 = SCADA.F.tkCIP; l1='TEMP C'; l2='PROD LVL'; l3='BOTTLES'; l4='CIP LVL'; max1=100; max3=5000; }
      else if (sc === 'CLEAN') { v1 = SCADA.CL.diff; v2 = SCADA.CL.part; v3 = SCADA.CL.rh; v4 = 68; l1='DIFF PA'; l2='PRTCL'; l3='RH %'; l4='TEMP F'; max1=100; max2=2000; max4=100; }
      else if (sc === 'DATA') { v1 = SCADA.D.sTemp; v2 = SCADA.D.kw; v3 = 40; v4 = 99; l1='TEMP F'; l2='kW'; l3='RH %'; l4='UPS %'; max1=150; max2=2000; }

      // Fix: Safely check for DOM elements before accessing .style
      const spoofWarn = document.getElementById('spoof-warning');
      const trendSpoofWarn = document.getElementById('trend-spoof-warning');
      if (spoofWarn) spoofWarn.style.display = att ? 'block' : 'none';
      if (trendSpoofWarn) trendSpoofWarn.style.display = att ? 'block' : 'none';

      document.getElementById('g1-lbl').innerText = l1; drawGauge('g1-can', v1, 0, max1, '#38bdf8'); document.getElementById('g1-val').innerText = v1.toFixed(1);
      document.getElementById('g2-lbl').innerText = l2; drawGauge('g2-can', v2, 0, max2, '#f59e0b'); document.getElementById('g2-val').innerText = v2.toFixed(1);
      document.getElementById('g3-lbl').innerText = l3; drawGauge('g3-can', v3, 0, max3, '#10b981'); document.getElementById('g3-val').innerText = v3.toFixed(1);
      document.getElementById('g4-lbl').innerText = l4; drawGauge('g4-can', v4, 0, max4, '#a855f7'); document.getElementById('g4-val').innerText = v4.toFixed(1);

      document.getElementById('trend-l1').innerText = l1; document.getElementById('trend-l2').innerText = l2; document.getElementById('trend-l3').innerText = l3;
      
      if (!SCADA.trendPaused) {
        SCADA.hist.p1.shift(); SCADA.hist.p1.push(v1/max1);
        SCADA.hist.p2.shift(); SCADA.hist.p2.push(v2/max2);
        SCADA.hist.p3.shift(); SCADA.hist.p3.push(v3/max3);
        drawTrend();
      }

      // Electrical Bus Spoofer logic
      document.getElementById('elec-volts').innerText = (480 + (Math.random()-0.5)*2).toFixed(1) + ' V';
      document.getElementById('elec-amps').innerText = (12 + (Math.random()-0.5)).toFixed(1) + ' A';
      document.getElementById('elec-freq').innerText = (60 + (Math.random()-0.5)*0.05).toFixed(2) + ' Hz';
    }

    function drawTrend() {
      const c = document.getElementById('trend-canvas'); if(!c) return; 
      const ctx = c.getContext('2d');
      c.width = c.clientWidth; c.height = c.clientHeight; const w = c.width, h = c.height;
      ctx.clearRect(0,0,w,h); ctx.strokeStyle='#1e293b'; ctx.lineWidth=1;
      for(let y=0; y<h; y+=25){ ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(w,y); ctx.stroke(); }
      const dp = (arr, col) => {
        ctx.beginPath(); ctx.strokeStyle=col; ctx.lineWidth=1.5; let step=w/39;
        for(let i=0; i<40; i++){ let x=i*step, y=h-(arr[i]*(h-10)+5); if(i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y); }
        ctx.stroke();
      };
      dp(SCADA.hist.p1, '#38bdf8'); dp(SCADA.hist.p2, '#f59e0b'); dp(SCADA.hist.p3, '#10b981');
    }

    function drawGauge(id, val, min, max, col) {
      let c = document.getElementById(id); if(!c) return; let ctx = c.getContext('2d'), w=c.width, h=c.height;
      ctx.clearRect(0,0,w,h);
      ctx.beginPath(); ctx.arc(w/2, h*0.8, w*0.35, Math.PI, 2*Math.PI); ctx.lineWidth=6; ctx.strokeStyle='#1e293b'; ctx.stroke();
      let pct = Math.max(0, Math.min(1, (val-min)/(max-min)));
      ctx.beginPath(); ctx.arc(w/2, h*0.8, w*0.35, Math.PI, Math.PI + pct*Math.PI); ctx.strokeStyle=col; ctx.stroke();
      
      // Center Hub
      ctx.beginPath(); ctx.arc(w/2, h*0.8, 3, 0, 2*Math.PI); ctx.fillStyle='#94a3b8'; ctx.fill();
    }

