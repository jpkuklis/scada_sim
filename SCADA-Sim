<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FACILITY ALPHA - Industrial Process Control System (SCADA)</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Industrial Digital Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;800;900&family=Share+Tech+Mono&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>
    body { font-family: 'Inter', sans-serif; user-select: none; overflow-x: hidden; background-color: #030712; }
    .font-digital { font-family: 'Share Tech Mono', monospace; }
    .font-tech { font-family: 'Orbitron', sans-serif; }

    .panel-bezel {
      background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
      border: 1px solid #334155;
      box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.05), 0 8px 20px rgba(0, 0, 0, 0.4);
    }
    .panel-inset {
      background: #090d16;
      box-shadow: inset 0 2px 6px rgba(0,0,0,0.8), 0 1px 0 rgba(255,255,255,0.05);
      border: 1px solid #1e293b;
    }

    .btn-tactile { transition: all 0.08s ease; box-shadow: 0 4px 0 #0f172a, inset 0 1px 0 rgba(255,255,255,0.2); }
    .btn-tactile:active { transform: translateY(3px); box-shadow: 0 1px 0 #0f172a, inset 0 1px 0 rgba(0,0,0,0.4); }

    @keyframes pipeFlow { from { stroke-dashoffset: 40; } to { stroke-dashoffset: 0; } }
    .pipe-flowing { stroke-dasharray: 8, 8; animation: pipeFlow 0.8s linear infinite; }
    .pipe-danger { stroke-dasharray: 8, 8; animation: pipeFlow 0.3s linear infinite; stroke: #ef4444 !important; }
    
    @keyframes spinImpeller { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    .spin-center {
      animation: spinImpeller 0.6s linear infinite;
      transform-box: fill-box;
      transform-origin: 50% 50%;
    }

    .led-off { background-color: #334155; box-shadow: inset 0 1px 3px rgba(0,0,0,0.8); }
    .led-green { background-color: #10b981; box-shadow: 0 0 10px #10b981, inset 0 1px 2px rgba(255,255,255,0.5); }
    .led-amber { background-color: #f59e0b; box-shadow: 0 0 10px #f59e0b, inset 0 1px 2px rgba(255,255,255,0.5); }
    .led-red { background-color: #ef4444; box-shadow: 0 0 10px #ef4444, inset 0 1px 2px rgba(255,255,255,0.5); }

    @keyframes glitchRed { 0% { opacity: 0; } 50% { opacity: 0.25; } 100% { opacity: 0; } }
    .attack-glitch { animation: glitchRed 0.8s infinite alternate; }
    @keyframes catastrophicShake {
      0%, 100% { transform: translate(0, 0); }
      20% { transform: translate(-2px, 2px); }
      40% { transform: translate(2px, -2px); }
      60% { transform: translate(-2px, -2px); }
      80% { transform: translate(2px, 2px); }
    }
    .catastrophic-failure { animation: catastrophicShake 0.4s infinite; filter: drop-shadow(0 0 12px #ef4444); }

    .estop-guard { transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1); transform-origin: top center; }
    .estop-guard.open { transform: rotateX(120deg); }
    .interactive-equip:hover { filter: drop-shadow(0 0 8px rgba(56, 189, 248, 0.6)); transition: filter 0.2s; cursor: pointer; }

    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #090d16; }
    ::-webkit-scrollbar-thumb { background: #334155; border-radius: 3px; }
  </style>
</head>
<body class="h-full flex flex-col overflow-x-hidden text-slate-200 relative">

  <div id="attack-overlay" class="absolute inset-0 bg-red-950/40 pointer-events-none z-50 hidden attack-glitch border-4 border-red-600/50"></div>

  <header class="bg-slate-900 border-b border-slate-800 px-4 py-2.5 shadow-xl flex-shrink-0 relative z-40">
    <div class="max-w-[1920px] mx-auto flex flex-wrap items-center justify-between gap-4">
      
      <!-- Facility Identification -->
      <div class="flex items-center gap-3">
        <div id="header-logo" class="w-10 h-10 rounded bg-cyan-950 border border-cyan-500/40 flex items-center justify-center shadow-lg shadow-cyan-950/50 transition-colors">
          <svg class="w-6 h-6 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
          </svg>
        </div>
        <div>
          <h1 class="font-tech text-base sm:text-lg font-bold tracking-wider text-slate-100 uppercase">Facility Alpha</h1>
          <p class="text-[10px] text-slate-400 font-mono flex items-center gap-2">
            <span>INDUSTRIAL PROCESS CONTROL SYSTEM</span>
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
            <span id="sys-status-text" class="text-cyan-400 font-bold tracking-wider">NORMAL</span>
          </p>
        </div>
      </div>

      <!-- Navigation & Mode Controls -->
      <div class="flex items-center gap-3 flex-wrap">
        
        <!-- Scenario Domain Selector -->
        <div class="flex flex-col">
          <label class="text-[9px] font-mono text-slate-400 uppercase tracking-wider mb-0.5">PROCESS DOMAIN</label>
          <select id="scenario-selector" onchange="switchScenario(this.value)" class="bg-slate-950 border border-slate-700 text-cyan-400 font-tech text-[10px] rounded px-2 py-1 focus:outline-none cursor-pointer">
            <option value="WATER">Water & Wastewater</option>
            <option value="CHEM">Chem Batch Synthesis</option>
            <option value="POWER">HV Power Substation</option>
            <option value="HVAC">HVAC Building Automation</option>
            <option value="OIL">Oil & Gas Pipeline</option>
            <option value="FOOD">Food & Beverage CIP</option>
            <option value="CLEAN">Cleanroom Fab</option>
            <option value="DATA">Data Center Power</option>
          </select>
        </div>

        <!-- Complexity Selector -->
        <div class="flex flex-col">
          <label class="text-[9px] font-mono text-slate-400 uppercase tracking-wider mb-0.5">COMPLEXITY</label>
          <div class="bg-slate-950 p-0.5 rounded border border-slate-800 flex items-center">
            <button onclick="setComplexity('SIMPLE')" id="cmp-SIMPLE" class="px-2 py-0.5 rounded text-[10px] font-mono text-slate-400 hover:text-slate-200">SIMP</button>
            <button onclick="setComplexity('INTERMEDIATE')" id="cmp-INTERMEDIATE" class="px-2 py-0.5 rounded text-[10px] font-mono bg-cyan-700 text-white font-bold shadow">INT</button>
            <button onclick="setComplexity('ADVANCED')" id="cmp-ADVANCED" class="px-2 py-0.5 rounded text-[10px] font-mono text-slate-400 hover:text-slate-200">ADV</button>
          </div>
        </div>

        <!-- Control Mode Switch -->
        <div class="flex flex-col">
          <label class="text-[9px] font-mono text-slate-400 uppercase tracking-wider mb-0.5">MODE</label>
          <div class="bg-slate-950 p-0.5 rounded border border-slate-800 flex items-center">
            <button onclick="setControlMode('AUTO')" id="btn-mode-auto" class="px-2 py-0.5 rounded text-[10px] font-mono bg-cyan-600 text-white shadow">AUTO</button>
            <button onclick="setControlMode('MANUAL')" id="btn-mode-manual" class="px-2 py-0.5 rounded text-[10px] font-mono text-slate-400">MANUAL</button>
          </div>
        </div>

        <!-- Cyber Drill Modal Trigger -->
        <button onclick="openSecurityMenu()" class="mt-3 px-3 py-1 rounded border border-purple-500/60 bg-purple-950/40 hover:bg-purple-900/60 text-purple-300 font-tech text-[10px] font-bold shadow-inner transition-colors">
          🛡️ CYBER DRILL
        </button>

        <!-- Hardwired Master E-STOP -->
        <div class="relative group mt-3">
          <div id="estop-latch-cover" onclick="toggleEstopGuard()" class="estop-guard absolute inset-0 z-20 bg-amber-500/30 border-2 border-amber-500/80 rounded cursor-pointer flex items-center justify-center hover:bg-amber-500/40 backdrop-blur-sm">
            <span class="text-[8px] font-bold font-mono text-amber-200 uppercase bg-slate-900/90 px-1 rounded border border-amber-500/50">LATCH</span>
          </div>
          <button onclick="triggerEstop()" class="px-4 py-1.5 rounded bg-gradient-to-b from-red-600 to-red-800 active:from-red-800 text-white font-tech text-xs font-black tracking-widest border border-red-400 shadow-lg btn-tactile flex items-center gap-1">
            E-STOP
          </button>
        </div>

      </div>

      <!-- Live Clocks & Uptime -->
      <div class="flex items-center gap-5 text-xs font-digital text-slate-400 border-l border-slate-800 pl-4 hidden xl:flex">
        <div class="flex items-center gap-2">
          <span class="text-[10px] text-slate-500">HEARTBEAT</span>
          <span id="plc-heartbeat-led" class="w-2.5 h-2.5 rounded-full led-green"></span>
        </div>
        <div><span class="text-slate-500 block text-[10px]">SYSTEM TIME</span><span id="live-clock" class="text-cyan-400 font-semibold text-sm">--:--:--</span></div>
        <div><span class="text-slate-500 block text-[10px]">UPTIME</span><span id="uptime-counter" class="text-slate-300 text-sm">00:00:00</span></div>
      </div>

    </div>
  </header>

  <main class="flex-1 p-3 sm:p-4 max-w-[1920px] w-full mx-auto grid grid-cols-1 lg:grid-cols-12 gap-4 overflow-y-auto">
    
    <!-- LEFT: CONTROLS (Dynamically Populated) -->
    <section class="lg:col-span-3 flex flex-col gap-4 overflow-y-auto pr-1" id="left-controls"></section>

    <!-- CENTER: P&ID SCHEMATIC & TREND -->
    <section class="lg:col-span-6 flex flex-col gap-4 h-full">
      
      <!-- Schematic Display -->
      <div class="panel-bezel rounded-lg p-3 flex flex-col flex-1 relative">
        <div id="failure-banner" class="absolute top-4 left-1/2 -translate-x-1/2 bg-red-600 text-white font-tech font-bold px-4 py-1 rounded z-20 hidden animate-pulse border-2 border-white shadow-[0_0_20px_red]">
          CRITICAL PHYSICAL RUPTURE DETECTED
        </div>
        <div class="flex items-center justify-between border-b border-slate-700/60 pb-2 mb-2">
          <h2 class="font-tech text-xs font-bold text-slate-200 tracking-wider flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-cyan-400"></span> ACTIVE SCHEMATIC (P&ID)
          </h2>
          <span id="scenario-title" class="text-[10px] font-mono text-cyan-400 font-bold bg-slate-900 px-2 py-0.5 rounded border border-slate-800 tracking-wider">WATER & WASTEWATER</span>
        </div>
        
        <div class="panel-inset rounded relative overflow-hidden bg-slate-950 flex-1 min-h-[380px] flex items-center justify-center p-1" id="svg-container">
          <!-- Dynamic SVG Canvas -->
          <svg id="pid-svg" viewBox="0 0 800 420" class="w-full h-full select-none" preserveAspectRatio="xMidYMid meet"></svg>
        </div>
      </div>

      <!-- Live Trend Chart -->
      <div class="panel-bezel rounded-lg p-3 flex flex-col h-56 relative">
        <div id="trend-spoof-warning" class="absolute top-2 right-2 text-[9px] bg-red-950 border border-red-500 text-red-200 px-2 py-0.5 rounded animate-pulse hidden z-10 font-mono">
          TELEMETRY SPOOFED BY MALWARE
        </div>
        <div class="flex items-center justify-between border-b border-slate-700/60 pb-1.5 mb-1.5">
          <h2 class="font-tech text-xs font-bold text-slate-200 tracking-wider flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-cyan-400"></span> REAL-TIME TELEMETRY TREND
          </h2>
          <div class="flex items-center gap-3 text-[10px] font-mono">
            <span class="text-cyan-400 flex items-center gap-1"><span class="w-2 h-0.5 bg-cyan-400"></span> <span id="trend-l1">PEN 1</span></span>
            <span class="text-amber-400 flex items-center gap-1"><span class="w-2 h-0.5 bg-amber-400"></span> <span id="trend-l2">PEN 2</span></span>
            <span class="text-emerald-400 flex items-center gap-1"><span class="w-2 h-0.5 bg-emerald-400"></span> <span id="trend-l3">PEN 3</span></span>
            <button onclick="toggleTrendPause()" id="btn-pause-chart" class="px-2 py-0.5 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded border border-slate-700 transition-colors">PAUSE</button>
          </div>
        </div>
        <div class="panel-inset rounded p-1 flex-1 relative">
          <canvas id="trend-canvas" class="w-full h-full block"></canvas>
        </div>
      </div>

    </section>

    <!-- RIGHT: GAUGES, METERS & ALARMS -->
    <section class="lg:col-span-3 flex flex-col gap-4 h-full">
      
      <!-- Analog Gauges -->
      <div class="panel-bezel rounded-lg p-3 flex flex-col gap-2">
        <div class="flex items-center justify-between border-b border-slate-700/60 pb-1.5">
          <h2 class="font-tech text-xs font-bold text-slate-200 tracking-wider flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-cyan-400"></span> ANALOG METRICS
          </h2>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div class="panel-inset rounded p-1.5 flex flex-col items-center">
            <span id="g1-lbl" class="text-[9px] font-mono text-slate-400">METRIC 1</span>
            <canvas id="g1-can" width="100" height="80" class="block"></canvas>
            <span id="g1-val" class="font-digital text-cyan-400 text-xs font-bold mt-1">0.0</span>
          </div>
          <div class="panel-inset rounded p-1.5 flex flex-col items-center">
            <span id="g2-lbl" class="text-[9px] font-mono text-slate-400">METRIC 2</span>
            <canvas id="g2-can" width="100" height="80" class="block"></canvas>
            <span id="g2-val" class="font-digital text-amber-400 text-xs font-bold mt-1">0.0</span>
          </div>
          <div class="panel-inset rounded p-1.5 flex flex-col items-center">
            <span id="g3-lbl" class="text-[9px] font-mono text-slate-400">METRIC 3</span>
            <canvas id="g3-can" width="100" height="80" class="block"></canvas>
            <span id="g3-val" class="font-digital text-emerald-400 text-xs font-bold mt-1">0.0</span>
          </div>
          <div class="panel-inset rounded p-1.5 flex flex-col items-center">
            <span id="g4-lbl" class="text-[9px] font-mono text-slate-400">METRIC 4</span>
            <canvas id="g4-can" width="100" height="80" class="block"></canvas>
            <span id="g4-val" class="font-digital text-purple-400 text-xs font-bold mt-1">0.0</span>
          </div>
        </div>
      </div>

      <!-- Electrical Bus -->
      <div class="panel-bezel rounded-lg p-3 flex flex-col gap-2">
        <div class="flex items-center justify-between border-b border-slate-700/60 pb-1.5">
          <h2 class="font-tech text-xs font-bold text-slate-200 tracking-wider flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-cyan-400"></span> 3-PHASE ELECTRICAL BUS
          </h2>
        </div>
        <div class="grid grid-cols-3 gap-1.5 font-digital">
          <div class="panel-inset p-1.5 rounded text-center">
            <span class="text-[8px] text-slate-500 block font-mono">VOLTS (L1-L2)</span>
            <span id="elec-volts" class="text-xs text-cyan-400 font-bold">480.2 V</span>
          </div>
          <div class="panel-inset p-1.5 rounded text-center">
            <span class="text-[8px] text-slate-500 block font-mono">LOAD CURRENT</span>
            <span id="elec-amps" class="text-xs text-amber-400 font-bold">12.4 A</span>
          </div>
          <div class="panel-inset p-1.5 rounded text-center">
            <span class="text-[8px] text-slate-500 block font-mono">FREQUENCY</span>
            <span id="elec-freq" class="text-xs text-emerald-400 font-bold">60.00 Hz</span>
          </div>
        </div>
      </div>

      <!-- Alarm Log -->
      <div class="panel-bezel rounded-lg p-3 flex-1 flex flex-col min-h-[220px]">
        <div class="flex items-center justify-between border-b border-slate-700/60 pb-1.5 mb-2">
          <h2 class="font-tech text-xs font-bold text-slate-200 tracking-wider flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-red-500"></span> ALARM / AUDIT LOG
          </h2>
          <div class="flex gap-1">
            <button onclick="ackAlarms()" class="text-[9px] font-mono bg-amber-800/80 hover:bg-amber-700 text-amber-200 px-2 py-0.5 rounded border border-amber-600/80 btn-tactile">ACK ALL</button>
            <button onclick="clearAlarms()" class="text-[9px] font-mono bg-slate-800 hover:bg-slate-700 text-slate-300 px-2 py-0.5 rounded border border-slate-700 btn-tactile">CLEAR</button>
          </div>
        </div>
        <div id="alarm-log" class="panel-inset rounded flex-1 p-1.5 overflow-y-auto space-y-1 text-[10px] font-mono"></div>
      </div>

    </section>
  </main>

  <div id="ctx-menu" class="fixed hidden z-50 bg-slate-900/95 border border-slate-600 rounded-lg shadow-[0_10px_40px_rgba(0,0,0,0.8)] py-1 text-[11px] font-mono w-64 text-slate-200 overflow-hidden backdrop-blur-xl">
    <div class="px-3 py-1.5 bg-slate-950 font-tech font-bold border-b border-slate-800 flex justify-between items-center">
      <span class="text-cyan-400">EQUIP COMMANDS</span>
      <span class="text-[9px] text-slate-400 bg-slate-800 px-1.5 rounded">ID: <span id="ctx-eid" class="text-white"></span></span>
    </div>
    <div id="ctx-body" class="py-1 divide-y divide-slate-800/60"></div>
  </div>

  <div id="tooltip" class="fixed pointer-events-none z-50 opacity-0 transition-opacity duration-150 bg-slate-900/95 border border-slate-600 rounded p-2.5 shadow-2xl text-[10px] font-mono min-w-[180px] backdrop-blur-md">
    <div class="font-tech font-bold text-cyan-400 border-b border-slate-700 pb-1 mb-1 flex justify-between" id="tt-id">
      <span>EQUIPMENT</span><span class="text-[8px] text-slate-500" id="tt-type">DEVICE</span>
    </div>
    <div id="tt-body" class="text-slate-300 space-y-0.5"></div>
  </div>

  <div id="modal-bg" class="fixed inset-0 z-50 bg-black/80 hidden flex items-center justify-center p-4 backdrop-blur-sm transition-all">
    <div class="bg-slate-900 border border-slate-700 rounded-lg max-w-2xl w-full p-6 shadow-[0_0_50px_rgba(0,0,0,0.9)] relative">
      <div class="flex justify-between items-center border-b border-slate-700 pb-2 mb-4">
        <h3 class="font-tech text-base font-bold text-purple-400">🛡️ CYBER DEFENSE & OPERATOR ERRORS</h3>
        <button onclick="document.getElementById('modal-bg').classList.add('hidden')" class="text-slate-400 hover:text-white transition-colors">✕</button>
      </div>
      <div id="modal-content" class="text-xs font-mono text-slate-300 space-y-4"></div>
    </div>
  </div>

  <div id="diag-modal-bg" class="fixed inset-0 z-50 bg-black/80 hidden flex items-center justify-center p-4 backdrop-blur-sm">
    <div class="bg-slate-900 border border-slate-700 rounded-lg max-w-md w-full p-5 shadow-2xl">
      <div class="flex justify-between items-center border-b border-slate-700 pb-2 mb-3">
        <h3 class="font-tech text-sm font-bold text-cyan-400">🩺 HEALTH DIAGNOSTICS</h3>
        <button onclick="document.getElementById('diag-modal-bg').classList.add('hidden')" class="text-slate-400 hover:text-white">✕</button>
      </div>
      <div id="diag-modal-content" class="text-xs font-mono text-slate-300 space-y-3"></div>
    </div>
  </div>

  <div id="toasts" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 pointer-events-none"></div>

  <script>
    // System State & Physical Models
    const SCADA = {
      scenario: 'WATER', cmp: 'INTERMEDIATE', mode: 'AUTO',
      estopLatch: false, estopActive: false, underAttack: false,
      failure: false, uptime: 0, trendPaused: false,
      loto: new Set(), faults: new Set(),
      hist: { p1: Array(40).fill(0), p2: Array(40).fill(0), p3: Array(40).fill(0), p4: Array(40).fill(0) },

      // Physics State Models (Complete Mass Conservation & Deadhead Physics)
      W: { tk1: 100, tk2: 20, p1: false, p2: false, v1: 0, v2: 0, sis: 100, press: 0, flow: 0 },
      C: { tkA: 90, tkB: 85, rx: 10, p1: false, p2: false, h: false, ag: false, temp: 24, press: 1, vDis: 0 },
      P: { cbM: true, cb1: true, cb2: false, cbTie: false, load: 45, freq: 60, volt: 13.8 },
      H: { ch1: false, ct1: false, ah1: false, v1: 0, d1: 0, sTemp: 74, flow: 0 },
      O: { p1: false, p2: false, v1: 100, tkS: 15, press: 100, flow: 0 },
      F: { pCIP: false, hx: false, fil: false, tkCIP: 100, tkProd: 50, temp: 20, count: 0 },
      CL: { f1: false, f2: false, s1: false, diff: 0, part: 500, rh: 45 },
      D: { crac1: false, crac2: false, ups: true, gen: false, ats: 'UTIL', kw: 1200, sTemp: 80 }
    };

    window.onload = () => {
      switchScenario('WATER');
      initEvents();
      setInterval(tickClock, 1000);
      setInterval(physicsLoop, 200);
      setInterval(telemetryLoop, 1000);
      log('SYS', 'SCADA Host Controller Booted. Validating all interlocks...', 'INFO');
    };

    // --- Core Loops ---
    function tickClock() {
      const d = new Date(); document.getElementById('live-clock').innerText = d.toTimeString().split(' ')[0];
      const hb = document.getElementById('plc-heartbeat-led'); hb.className = (d.getSeconds() % 2 === 0) ? 'w-2.5 h-2.5 rounded-full led-green' : 'w-2.5 h-2.5 rounded-full led-off';
      SCADA.uptime++;
      const h = String(Math.floor(SCADA.uptime/3600)).padStart(2,'0'), m = String(Math.floor((SCADA.uptime%3600)/60)).padStart(2,'0'), s = String(SCADA.uptime%60).padStart(2,'0');
      document.getElementById('uptime-counter').innerText = `${h}:${m}:${s}`;
    }

    function physicsLoop() {
      if (SCADA.estopActive && !SCADA.underAttack) return;
      if (SCADA.underAttack) { applyStuxnet(); renderSVG(); return; }

      const c = SCADA.cmp;
      
      // 1. WATER SCENARIO
      if (SCADA.scenario === 'WATER') {
        let w = SCADA.W;
        let pOn = (w.p1 && !SCADA.faults.has('P-101')) || (c !== 'SIMPLE' && w.p2 && !SCADA.faults.has('P-102'));
        
        if (pOn) {
          if (w.v1 > 0 && w.sis > 0 && w.tk2 < 100 && w.tk1 > 0) {
            // Normal Flow Math
            let actualFlow = (w.v1/100) * (w.sis/100) * 120 * (w.p1 && w.p2 ? 1.4 : 1);
            let transfer = Math.min(actualFlow * 0.01, w.tk1, 100 - w.tk2);
            w.tk1 -= transfer; w.tk2 += transfer;
            w.flow = transfer * 500;
            w.press = 30 + (w.flow * 0.05) + (Math.random()*2);
          } else {
            // Cavitation or Deadheading Physics
            w.flow = 0;
            if (w.tk1 <= 0) {
              w.press = Math.max(0, w.press - 2); // Pump Cavitating (No source fluid)
            } else if (w.tk2 >= 100 || w.v1 === 0 || w.sis === 0) {
              w.press += 4; // Deadhead: Pump running against closed valve or full tank
            }
          }
        } else {
          w.flow = 0; w.press = Math.max(0, w.press - 5);
        }
        if (w.press > 180 && !SCADA.failure) triggerFail('Overpressure Rupture in Water Main (Deadhead)');
      }

      // 2. CHEM SCENARIO
      else if (SCADA.scenario === 'CHEM') {
        let chem = SCADA.C;
        // Conservation of mass: Tanks A/B to Reactor
        if (chem.p1 && !SCADA.faults.has('P-201A') && chem.tkA > 0 && chem.rx < 100) { chem.tkA -= 0.1; chem.rx += 0.1; }
        if (c !== 'SIMPLE' && chem.p2 && !SCADA.faults.has('P-201B') && chem.tkB > 0 && chem.rx < 100) { chem.tkB -= 0.1; chem.rx += 0.1; }
        
        // Discharge Logic
        if (chem.vDis > 0 && chem.rx > 0) chem.rx -= (chem.vDis/100) * 0.15;
        
        // Heating Loop Thermodynamics
        if (chem.h && chem.rx > 0) chem.temp += 0.4; else chem.temp = Math.max(24, chem.temp - 0.1);
        chem.press = 1.0 + ((chem.temp - 24) * 0.05);
        if (chem.press > 12 && !SCADA.failure) triggerFail('Reactor Overpressure Explosion (Thermal Runaway)');
      }

      // 3. POWER SCENARIO
      else if (SCADA.scenario === 'POWER') {
        let p = SCADA.P;
        let onlineCap = p.cbM ? 100 : 0;
        let actualLoad = (p.cb1 ? 40 : 0) + ((c!=='SIMPLE' && p.cb2) ? 40 : 0);
        p.load = p.cbM ? actualLoad : 0;
        p.freq = p.cbM ? (actualLoad > onlineCap ? 59.2 : 60 + (Math.random()-0.5)*0.05) : 0;
        p.volt = p.cbM ? 13.8 - (p.load * 0.01) : 0;
      }

      // 4. HVAC SCENARIO
      else if (SCADA.scenario === 'HVAC') {
        let h = SCADA.H;
        if (h.ah1 && !SCADA.faults.has('AHU-1')) {
          h.flow = (h.v1/100) * 8000;
          let coolPwr = h.ch1 ? 2.0 : 0;
          h.sTemp = Math.max(55, h.sTemp - coolPwr + 0.2); 
        } else {
          h.flow = 0; h.sTemp = Math.min(85, h.sTemp + 0.1);
        }
      }
      
      // 5. OIL PIPELINE SCENARIO
      else if (SCADA.scenario === 'OIL') {
        let o = SCADA.O;
        let pOn = (o.p1 && !SCADA.faults.has('P-Main')) || (c!=='SIMPLE' && o.p2);
        if (pOn) {
          if (o.v1 > 0) {
            o.flow = (o.v1/100) * 600; o.press = 150 + (o.flow * 0.1); o.tkS = Math.max(5, o.tkS - 0.1);
          } else {
            o.flow = 0; o.press += 10; // Rapid deadhead spike against blocked valve
            if (c === 'ADVANCED' && o.press > 300) o.tkS = Math.min(100, o.tkS + 0.5); // Relief opens
          }
        } else { o.flow = 0; o.press = Math.max(50, o.press - 5); }
        if (o.press > 600 && !SCADA.failure) triggerFail('Oil Pipeline Rupture (Exceeded MAOP)');
      }

      // 6. FOOD & BEVERAGE SCENARIO
      else if (SCADA.scenario === 'FOOD') {
        let f = SCADA.F;
        if (f.hx) f.temp = Math.min(85, f.temp + 0.5); else f.temp = Math.max(20, f.temp - 0.2);
        if (f.fil && !SCADA.faults.has('M-FIL')) {
          if (f.tkProd > 0) { f.tkProd -= 0.05; f.count += 1.5; }
        }
        if (f.pCIP && f.tkCIP > 0) f.tkCIP -= 0.02; // CIP cycle consumes fluid
      }

      // 7. CLEANROOM SCENARIO
      else if (SCADA.scenario === 'CLEAN') {
        let cl = SCADA.CL;
        let fanPwr = (cl.f1 ? 1 : 0) + ((c!=='SIMPLE' && cl.f2) ? 1 : 0);
        cl.diff = fanPwr * 45;
        if (fanPwr > 0) cl.part = Math.max(10, cl.part - 5); else cl.part = Math.min(2000, cl.part + 10);
      }

      // 8. DATA CENTER SCENARIO
      else if (SCADA.scenario === 'DATA') {
        let d = SCADA.D;
        let cool = (d.crac1 ? 1 : 0) + ((c!=='SIMPLE' && d.crac2) ? 1 : 0);
        if (d.ups) {
          d.sTemp = Math.max(68, d.sTemp - (cool * 0.5) + 0.2); 
          d.kw = 1200 + (cool * 150);
        } else {
          d.kw = 0; d.sTemp += 0.5;
        }
        if (d.sTemp > 105 && !SCADA.failure) triggerFail('Thermal Runaway in Server Hall (HVAC Failure)');
      }

      renderSVG();
    }

    function applyStuxnet() {
      const s = SCADA.scenario;
      // Stuxnet forces logic ON and closes valves/cooling to induce deadheading or thermal runaway
      if (s === 'WATER') { SCADA.W.p1 = true; SCADA.W.v1 = 0; SCADA.W.press += 5; if(SCADA.W.press > 250) triggerFail('Water Main Rupture (Stuxnet Payload)'); }
      else if (s === 'CHEM') { SCADA.C.h = true; SCADA.C.vDis = 0; SCADA.C.temp += 1.5; SCADA.C.press += 0.5; if(SCADA.C.press > 15) triggerFail('Reactor Explosion (Stuxnet Payload)'); }
      else if (s === 'OIL') { SCADA.O.p1 = true; SCADA.O.v1 = 0; SCADA.O.press += 15; if(SCADA.O.press > 700) triggerFail('Pipeline Burst (Stuxnet Payload)'); }
      else triggerFail('Catastrophic Overload (Stuxnet Payload)');
    }

    function triggerFail(msg) {
      if (SCADA.failure) return;
      SCADA.failure = true;
      document.getElementById('svg-container').classList.add('catastrophic-failure');
      const banner = document.getElementById('failure-banner');
      if(banner) { banner.innerText = msg; banner.classList.remove('hidden'); }
      log('FAIL', msg, 'CRIT');
      const sysStatus = document.getElementById('sys-status-text');
      if(sysStatus) { sysStatus.innerText = 'CRITICAL FAULT'; sysStatus.className = 'text-red-500 font-bold tracking-wider animate-pulse'; }
    }

    const SvgFactory = {
      pipe: (d, flow, danger, color) => {
        let c = flow ? (danger ? '#ef4444' : color) : 'transparent';
        let cl = flow ? (danger ? 'pipe-danger' : 'pipe-flowing') : '';
        return `<path d="${d}" fill="none" stroke="#1e293b" stroke-width="8" stroke-linecap="round"/><path d="${d}" fill="none" stroke="${c}" stroke-width="4" class="${cl}" stroke-linecap="round"/>`;
      },
      equip: (x, y, id, inner, type) => `<g transform="translate(${x}, ${y})" class="interactive-equip" data-equip="${id}" data-type="${type}">${inner}</g>`,
      
      // Clean, centered impeller avoiding "flying X's"
      pump: (x, y, id, run, fault, loto) => {
        let col = fault ? '#ef4444' : (run ? '#10b981' : '#475569');
        let spin = (run && !fault) ? 'spin-center' : '';
        return SvgFactory.equip(x, y, id, `
          <circle cx="0" cy="0" r="16" fill="#0f172a" stroke="${col}" stroke-width="2"/>
          <g class="${spin}">
            <path d="M 0 0 L 0 -10 M 0 0 L 8 5 M 0 0 L -8 5" stroke="${col}" stroke-width="3" stroke-linecap="round"/>
          </g>
          <text x="0" y="28" fill="#94a3b8" font-size="9" font-family="Orbitron" text-anchor="middle">${id}</text>
          ${loto?'<rect x="8" y="-14" width="12" height="16" fill="#ef4444" stroke="#fff"/><text x="14" y="-5" fill="#fff" font-size="5" font-family="monospace" text-anchor="middle">LOTO</text>':''}
        `, 'PUMP');
      },
      fan: (x, y, id, run, fault, loto) => {
        let col = fault ? '#ef4444' : (run ? '#38bdf8' : '#475569');
        let spin = (run && !fault) ? 'spin-center' : '';
        return SvgFactory.equip(x, y, id, `
          <circle cx="0" cy="0" r="16" fill="#0f172a" stroke="${col}" stroke-width="2"/>
          <g class="${spin}">
            <path d="M -8 -8 L 8 8 M 8 -8 L -8 8" stroke="${col}" stroke-width="2.5" stroke-linecap="round"/>
          </g>
          <text x="0" y="28" fill="#94a3b8" font-size="9" font-family="Orbitron" text-anchor="middle">${id}</text>
          ${loto?'<rect x="8" y="-14" width="12" height="16" fill="#ef4444" stroke="#fff"/>':''}
        `, 'FAN');
      },
      valve: (x, y, id, pct, loto) => {
        let col = pct > 0 ? '#10b981' : '#ef4444';
        return SvgFactory.equip(x, y, id, `
          <polygon points="-11,-8 11,8 11,-8 -11,8" fill="${col}" stroke="#0f172a"/>
          <text x="0" y="-12" fill="#94a3b8" font-size="8" font-family="Orbitron" text-anchor="middle">${id} (${pct}%)</text>
          ${loto?'<rect x="8" y="-16" width="10" height="14" fill="#ef4444" stroke="#fff"/>':''}
        `, 'VALVE');
      },
      tank: (x, y, id, lvl, w, h, col) => {
        let fillH = Math.max(0, (lvl/100)*h);
        return SvgFactory.equip(x, y, id, `
          <rect width="${w}" height="${h}" rx="4" fill="#070a12" stroke="#475569" stroke-width="2"/>
          <rect y="${h-fillH}" width="${w}" height="${fillH}" rx="2" fill="${col}" opacity="0.8"/>
          <text x="${w/2}" y="-8" fill="#e2e8f0" font-size="10" font-family="Orbitron" text-anchor="middle">${id}</text>
          <text x="${w/2}" y="${h/2+4}" fill="#fff" font-size="12" font-family="Share Tech Mono" text-anchor="middle">${lvl.toFixed(1)}%</text>
        `, 'TANK');
      },
      breaker: (x, y, id, closed) => {
        let col = closed ? '#10b981' : '#ef4444';
        return SvgFactory.equip(x, y, id, `<rect x="-12" y="-8" width="24" height="16" fill="${col}" stroke="#0f172a"/><text x="0" y="20" fill="#94a3b8" font-size="8" font-family="Orbitron" text-anchor="middle">${id}</text>`, 'BREAKER');
      }
    };

